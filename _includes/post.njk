---
layout: base.njk
---

{% set readingTime = content | readTime %}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": {{ title | dump | safe }},
  "description": {{ description | dump | safe }},
  "datePublished": "{{ date | isoDate }}",
  "dateModified": "{{ date | isoDate }}",
  "url": "{{ canonical }}",
  "image": "{{ ogImage }}",
  "author": {
    "@type": "Organization",
    "name": "Express HR Solutions",
    "url": "https://www.expresshrsolutions.com/"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Express HR Solutions",
    "logo": {
      "@type": "ImageObject",
      "url": "https://www.expresshrsolutions.com/assets/logo-icon.png"
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": "{{ canonical }}"
  }
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.expresshrsolutions.com/" },
    { "@type": "ListItem", "position": 2, "name": "Blog", "item": "https://www.expresshrsolutions.com/blog/" },
    { "@type": "ListItem", "position": 3, "name": {{ title | dump | safe }}, "item": "{{ canonical }}" }
  ]
}
</script>

<article class="post-page">
  <div class="post-inner">

    <nav class="post-breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a> &nbsp;/&nbsp;
      <a href="/blog/">Blog</a> &nbsp;/&nbsp;
      {{ title }}
    </nav>

    <div class="post-cat">{{ category }}</div>

    <h1 class="post-title">{{ title }}</h1>

    <div class="post-meta-bar">
      <div class="post-date">{{ date | fullDate }} &nbsp;&middot;&nbsp; {{ readingTime }} min read</div>
    </div>

    {% if featured_image %}
    <img
      class="post-featured-img"
      src="{{ featured_image }}"
      alt="{{ title }}"
      width="1200"
      height="420"
      loading="lazy"
    >
    {% endif %}

    <div class="post-body">
      {{ content | safe }}
    </div>

    <div class="post-cta">
      <p>Need help with workforce management or compliance? <a href="/#services">See our services</a> or <a href="/#contact">get in touch</a>.</p>
    </div>

    <a href="/blog/" class="post-back">&larr; Back to all posts</a>

  </div>
</article>

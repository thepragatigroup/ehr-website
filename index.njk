            <circle class="map-amb" cx="723.5" cy="405.6" r="4"/>
            <circle class="map-amb" cx="835.5" cy="375.5" r="4"/>
          </g>
          <!-- regional site markers -->
          <g class="map-dot" style="--d:.0s"  transform="translate(160.8 487.2)"><circle class="map-pulse" r="9"/><circle class="map-core" r="6"/></g>

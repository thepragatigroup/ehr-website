            <circle class="map-amb" cx="522.2" cy="606.6" r="4"/><circle class="map-amb" cx="420.7" cy="739.9" r="4"/><circle class="map-amb" cx="371" cy="705.9" r="4"/><circle class="map-amb" cx="543.4" cy="614.2" r="4"/>
            <circle class="map-amb" cx="319.5" cy="528.2" r="4"/><circle class="map-amb" cx="392" cy="512.6" r="4"/><circle class="map-amb" cx="459.8" cy="457.5" r="4"/><circle class="map-amb" cx="374.1" cy="395.2" r="4"/><circle class="map-amb" cx="396.2" cy="460.1" r="4"/>
            <circle class="map-amb" cx="278" cy="722.4" r="4"/><circle class="map-amb" cx="305.8" cy="740.8" r="4"/><circle class="map-amb" cx="313.9" cy="770.4" r="4"/><circle class="map-amb" cx="334.1" cy="693.4" r="4"/><circle class="map-amb" cx="337.3" cy="751.1" r="4"/>

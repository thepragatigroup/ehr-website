          <g class="map-dot map-dot--hq" transform="translate(233.2 605.6)">
            <circle class="map-pulse map-pulse--hq" r="13"/>
            <circle class="map-ring" r="13"/>
            <circle class="map-core map-core--hq" r="8"/>
          </g>
        </svg>
        <div class="stats__map-legend">
          <span class="stats__map-legend-item"><span class="stats__map-legend-dot stats__map-legend-dot--hq"></span>Mumbai · Headquarters</span>
          <span class="stats__map-legend-item"><span class="stats__map-legend-dot"></span>Major industrial hub</span>
          <span class="stats__map-legend-item"><span class="stats__map-legend-swatch"></span>Active deployment coverage</span>
        </div>
      </div>

      </div><!-- /stats__top -->

      <div class="stats__metrics">
        <div class="stats__item">
          <span class="stats__num" data-count="15000" data-suffix="+">0+</span>
          <span class="stats__label">Manpower Deployed</span>
        </div>
        <div class="stats__item">
          <span class="stats__num" data-count="2000000" data-suffix="">0</span>
          <span class="stats__label">Sq Ft Managed</span>
        </div>
        <div class="stats__item">
          <span class="stats__num" data-count="50" data-suffix="+">0+</span>
          <span class="stats__label">Active Sites</span>
        </div>
        <div class="stats__item">
          <span class="stats__num" data-count="150" data-suffix="+">0+</span>
          <span class="stats__label">Transport Fleet</span>
        </div>
        <div class="stats__item stats__item--badge">
          <span class="stats__num" data-count="100" data-suffix="%">0%</span>
          <span class="stats__label">Compliant</span>
        </div>
      </div>

    </div>
  </section>

  <!-- TESTIMONIAL -->
  <section class="testimonial">
    <div class="container testimonial__container">
      <i class="ph ph-quotes testimonial__icon"></i>
      <blockquote class="testimonial__quote">
        Express HR Solutions turned finance from a bottleneck into a partner.
      </blockquote>
      <div class="testimonial__attr">
        <span class="testimonial__name">Ankit Ahuja</span>
        <span class="testimonial__company">Reliance</span>
      </div>
    </div>
  </section>

  <!-- BLOG CAROUSEL -->
  <section class="blog-section">
    <div class="container">
      <div class="eyebrow">Latest Insights</div>
      <h2 class="section-title">From the Field</h2>
      <p class="section-subtitle">Workforce strategy, compliance updates, and operations thinking from our team.</p>

      <div class="blog-carousel">
        {% for post in collections.blog | featuredPosts %}
        <article class="blog-card">
          <a href="{{ post.url }}">
            <img
              class="blog-card__img"
              src="{{ post.data.featured_image }}"
              alt="{{ post.data.title }}"
              loading="lazy"
            >
          </a>
          <div class="blog-card__body">
            <div class="blog-card__meta">
              <span class="blog-card__cat">{{ post.data.category }}</span>
              <span class="blog-card__date">{{ post.date | monthYear }}</span>
            </div>
            <h3 class="blog-card__title">
              <a href="{{ post.url }}" style="color:inherit;text-decoration:none;">{{ post.data.title }}</a>
            </h3>
            <p class="blog-card__excerpt">{{ post.data.excerpt }}</p>
            <a href="{{ post.url }}" class="blog-card__link">Read &rarr;</a>
          </div>
        </article>
        {% endfor %}
      </div>

      <div class="blog-section__foot">
        <a href="/blog/" class="btn btn--outline">View All Posts</a>
      </div>
    </div>
  </section>

  <!-- CONTACT (Step 9) -->
  <section class="contact" id="contact">
    <div class="container contact__container">

      <div class="contact__left">
        <h2 class="contact__title">Ready to Transform Your Workforce Operations?</h2>
        <form class="contact__form" id="contactForm">
          <div class="contact__field">
            <input type="text" name="name" placeholder="Your Name" required class="contact__input">
          </div>
          <div class="contact__field">
            <input type="text" name="company" placeholder="Company Name" required class="contact__input">
          </div>
          <div class="contact__field">
            <input type="tel" name="phone" placeholder="Phone Number" required class="contact__input">
          </div>
          <div class="contact__field">
            <textarea name="message" placeholder="Tell us about your requirement" rows="4" class="contact__input contact__textarea"></textarea>
          </div>
          <button type="submit" class="btn contact__submit" id="contactSubmit">
            Send Message <i class="ph ph-paper-plane-tilt"></i>
          </button>
          <p class="contact__success" id="contactSuccess" hidden>✓ Message sent! We'll get back to you shortly.</p>
          <p class="contact__error" id="contactError" hidden>Something went wrong. Please call us directly.</p>
        </form>
      </div>

      <div class="contact__right">
        <div class="contact__details">
          <div class="contact__detail">
            <i class="ph ph-envelope-simple contact__detail-icon"></i>
            <span>info@expresshrsolutions.com</span>
          </div>
          <div class="contact__detail">
            <i class="ph ph-phone contact__detail-icon"></i>
            <span>+91 99673 26161</span>
          </div>
          <div class="contact__detail">
            <i class="ph ph-map-pin contact__detail-icon"></i>
            <span>Mumbai, Maharashtra, India</span>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- CAREERS (Step 9) -->
  <section class="careers" id="careers">
    <div class="container careers__container">
      <h3 class="careers__title">Join India's fastest-growing workforce company</h3>
      <p class="careers__sub">We're hiring supervisors, HR executives, and operations managers across India.</p>
      <a href="mailto:careers@expresshrsolutions.com" class="btn btn--primary">View Open Positions</a>
    </div>
  </section>
